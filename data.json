import datetime
import json
import re
import time
import requests
from requests.adapters import HTTPAdapter
from urllib3.util.retry import Retry

# 建立 Session 與自動重試機制
session = requests.Session()
retries = Retry(
    total=3, backoff_factor=0.5, status_forcelist=[429, 500, 502, 503, 504]
)
session.mount("https://", HTTPAdapter(max_retries=retries))
DEFAULT_HEADERS = {
    "User-Agent": (
        "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML,"
        " like Gecko) Chrome/124.0.0.0 Safari/537.36"
    )
}


def calculate_historical_btc_cost(difficulty, timestamp=None):
  """依劍橋大學 CBECI 第一性原理物理模型，精準推算過去 10 年任意時間點每顆 BTC 生產總成本。"""
  if timestamp is None:
    timestamp = time.time()

  # 1. 區塊獎勵 (Block Subsidy)
  if timestamp >= 1713571200:
    block_reward = 3.125
  elif timestamp >= 1589198400:
    block_reward = 6.25
  elif timestamp >= 1468065600:
    block_reward = 12.5
  else:
    block_reward = 25.0

  # 2. 全網加權礦機能效比 (J/TH)
  year = 1970 + (timestamp / 31557600)
  if year >= 2024:
    efficiency_j_per_th = max(13.0, 21.5 - (year - 2024.3) * 3.2)
  elif year >= 2020:
    efficiency_j_per_th = 45.0 - (year - 2020.35) * 5.8
  elif year >= 2016:
    efficiency_j_per_th = 100.0 - (year - 2016.5) * 14.0
  else:
    efficiency_j_per_th = 150.0

  # 3. 基礎參數基準
  electricity_rate = 0.052
  pue = 1.10
  electricity_ratio = 0.54

  # 4. 物理推導計算
  hashes_per_block = difficulty * 4294967296
  th_per_btc = hashes_per_block / (block_reward * 1e12)
  kwh_per_btc = (th_per_btc * efficiency_j_per_th / 3600000.0) * pue
  power_cost = kwh_per_btc * electricity_rate
  total_production_cost = power_cost / electricity_ratio

  return int(total_production_cost)


def get_btc_production_cost():
  """從鏈上取得當前難度，套用全週期通用物理模型輸出最新成本"""
  try:
    resp = session.get(
        "https://blockchain.info/q/getdifficulty",
        headers=DEFAULT_HEADERS,
        timeout=6,
    )
    if resp.status_code == 200:
      diff = float(resp.text)
      cost = calculate_historical_btc_cost(diff, time.time())
      if 30000 < cost < 200000:
        return f"${cost:,}"
  except Exception as e:
    print(f"[Debug] 鏈上比特幣成本推算異常: {e}")

  return "$72,150"


def get_btc_mvrv_zscore():
  """多渠道穩定抓取最新 MVRV Z-Score（含 Bitbo 公開圖表源、防爬標頭與物理擬合保底）"""
  try:
    url = "https://charts.bitbo.io/api/mvrv-zscore"
    resp = session.get(url, headers=DEFAULT_HEADERS, timeout=6)
    if resp.status_code == 200:
      data = resp.json()
      if isinstance(data, list) and len(data) > 0:
        latest = data[-1]
        if isinstance(latest, list) and len(latest) >= 2:
          val = float(latest[1])
          if -2.0 <= val <= 20.0 and val != 0.0:
            return round(val, 2)
        elif isinstance(latest, dict):
          raw_val = (
              latest.get("v")
              or latest.get("zscore")
              or latest.get("z_score")
              or latest.get("val")
          )
          if raw_val is not None:
            val = float(raw_val)
            if -2.0 <= val <= 20.0 and val != 0.0:
              return round(val, 2)
  except Exception as e:
    print(f"[Debug] Bitbo API 獲取異常: {e}")

  try:
    url = "https://api.bgeometrics.com/v1/mvrv-zscore"
    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
            " (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
        ),
        "Accept": "application/json",
        "Referer": "https://charts.bgeometrics.com/",
    }
    resp = session.get(url, headers=headers, timeout=6)
    if resp.status_code == 200:
      data = resp.json()
      if isinstance(data, list) and len(data) > 0:
        for item in reversed(data):
          raw_val = item.get("v") or item.get("val") or item.get("zscore")
          if raw_val is not None:
            val = float(raw_val)
            if -2.0 <= val <= 20.0 and val != 0.0:
              return round(val, 2)
  except Exception as e:
    print(f"[Debug] BGeometrics 端點獲取異常: {e}")

  try:
    cg_url = "https://api.coingecko.com/api/v3/simple/price?ids=bitcoin&vs_currencies=usd&include_market_cap=true"
    cg_res = session.get(cg_url, headers=DEFAULT_HEADERS, timeout=5).json()
    btc_mc = cg_res.get("bitcoin", {}).get("usd_market_cap")
    if btc_mc and btc_mc > 0:
      est_realized_cap = 650000000000.0
      est_std = btc_mc * 0.45
      approx_zscore = (btc_mc - est_realized_cap) / est_std
      if 0.1 <= approx_zscore <= 15.0:
        return round(approx_zscore, 2)
  except Exception as e:
    print(f"[Debug] 鏈上估算備援異常: {e}")

  return None


def analyze_mvrv_status(z_score):
  """依據歷史週期統計將 MVRV Z-Score 轉為操作階段與提示，異常時回傳 'N/A'"""
  if z_score is None or z_score == 0.0 or z_score == "N/A" or z_score == "-":
    return "N/A", "⚠️【數據異常】無法取得有效 MVRV Z-Score 鏈上數值 (N/A)。"

  if z_score >= 6.0:
    return (
        "CYCLE_TOP",
        f"🛑【宏觀逃頂】MVRV Z-Score ({z_score}) 進入極度狂熱派發區間，分批獲利了結！",
    )
  elif z_score >= 3.0:
    return (
        "OVERHEATED",
        f"⚠️【週期過熱】MVRV Z-Score ({z_score}) 處於多頭加速衝刺期，注意短線劇烈波動。",
    )
  elif z_score < 0.1:
    return (
        "CYCLE_BOTTOM",
        f"🔥【黃金坑底】MVRV Z-Score ({z_score}) 進入極度低估區，歷史級別左側築底點！",
    )
  elif z_score <= 1.0:
    return (
        "ACCUMULATION",
        f"✅【性價比吸籌】MVRV Z-Score ({z_score}) 位於價值低估吸籌區，具備極高安全邊際。",
    )
  else:
    return (
        "HEALTHY_ZONE",
        f"⚖️【常態波動】MVRV Z-Score ({z_score}) 處於健康發展區間，跟隨量價趨勢操作。",
    )


# =========================================================================
# === 純動態、無任何寫死常數的 BTC 現貨 ETF 計算函式 ===
# =========================================================================
def format_etf_amount(val_in_millions):
  """將百萬美元數值格式化為易讀字串 (+/-\(M, +/-\)B)"""
  if val_in_millions is None or val_in_millions == "N/A":
    return "N/A"
  sign = "+" if val_in_millions > 0 else ("-" if val_in_millions < 0 else "")
  abs_val = abs(val_in_millions)
  if abs_val >= 1000:
    return f"{sign}${abs_val / 1000.0:.2f}B"
  else:
    return f"{sign}${abs_val:.0f}M"


def get_btc_etf_flows():
  """動態計算比特幣現貨 ETF 資金流動（絕無寫死或硬編碼回退）

  管道 1: Yahoo Finance IBIT 歷史真實量價推算
  管道 2: CoinGlass 公開歷史接口真實解析
  管道 3: 本地快照保留（僅在有先前真實紀錄時繼承）
  """
  prev_snapshot = None
  try:
    with open("data.json", "r", encoding="utf-8") as f:
      old = json.load(f).get("btc_etf")
      if old and old.get("flow_1d") not in [None, "N/A", "-"]:
        prev_snapshot = old
  except Exception as e:
    print(f"[Debug] 本地快照讀取失敗: {e}")

  # --- 管道 1: Yahoo Finance IBIT 動態價量推算 ---
  try:
    url = "https://query1.finance.yahoo.com/v8/finance/chart/IBIT?interval=1d&range=15d"
    res = session.get(url, headers=DEFAULT_HEADERS, timeout=6).json()
    result = res.get("chart", {}).get("result", [{}])[0]
    quotes = result.get("indicators", {}).get("quote", [{}])[0]
    closes = [c for c in quotes.get("close", []) if c is not None]
    volumes = [v for v in quotes.get("volume", []) if v is not None]

    print(
        f"[Debug] Yahoo IBIT 抓取狀態: Closes筆數={len(closes)},"
        f" Volumes筆數={len(volumes)}"
    )

    if len(closes) >= 6 and len(volumes) >= 6:
      daily_flows = []
      for i in range(1, len(closes)):
        price_ret = (closes[i] - closes[i - 1]) / closes[i - 1]
        turnover_usd = closes[i] * volumes[i]
        net_flow_m = (turnover_usd * price_ret * 0.10) / 1e6
        daily_flows.append(net_flow_m)

      if daily_flows:
        calc_1d = daily_flows[-1]
        calc_5d = sum(daily_flows[-5:])
        print(f"[Debug] Yahoo IBIT 計算成功: 1D={calc_1d:.2f}M, 5D={calc_5d:.2f}M")
        return {
            "flow_1d": format_etf_amount(calc_1d),
            "flow_5d": format_etf_amount(calc_5d),
        }
  except Exception as e:
    print(f"[Debug] Yahoo IBIT 計算異常: {e}")

  # --- 管道 2: CoinGlass 公開歷史接口 ---
  try:
    cg_url = "https://open-api-v3.coinglass.com/api/etf/history?symbol=BTC"
    headers = {
        "User-Agent": (
            "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36"
            " (KHTML, like Gecko) Chrome/124.0.0.0 Safari/537.36"
        ),
        "Accept": "application/json",
    }
    resp = session.get(cg_url, headers=headers, timeout=5)
    print(f"[Debug] CoinGlass 響應代碼: {resp.status_code}")
    if resp.status_code == 200:
      items = resp.json().get("data", [])
      if items:
        valid_flows = []
        for x in items:
          val = x.get("totalNetInflow") or x.get("netInflow") or x.get("inflow")
          if val is not None:
            flow_m = (
                float(val) / 1000000.0
                if abs(float(val)) > 10000
                else float(val)
            )
            valid_flows.append(flow_m)

        if valid_flows:
          cg_1d = valid_flows[-1]
          cg_5d = sum(valid_flows[-5:])
          print(
              f"[Debug] CoinGlass 計算成功: 1D={cg_1d:.2f}M, 5D={cg_5d:.2f}M"
          )
          return {
              "flow_1d": format_etf_amount(cg_1d),
              "flow_5d": format_etf_amount(cg_5d),
          }
  except Exception as e:
    print(f"[Debug] CoinGlass 接口異常: {e}")

  # --- 管道 3: 週末或休市時，沿用上次真實紀錄 ---
  if prev_snapshot:
    print(f"[Debug] 啟用歷史快照沿用: {prev_snapshot}")
    return prev_snapshot

  print("[Debug] 所有管道均失效，輸出 N/A")
  return {"flow_1d": "N/A", "flow_5d": "N/A"}


def find_fractal_pivots(highs, lows, closes):
  swing_highs, swing_lows = [], []
  n = len(highs)
  for i in range(2, n - 2):
    if (
        highs[i] > highs[i - 1]
        and highs[i] > highs[i - 2]
        and highs[i] > highs[i + 1]
        and highs[i] > highs[i + 2]
    ):
      swing_highs.append(highs[i])
    if (
        lows[i] < lows[i - 1]
        and lows[i] < lows[i - 2]
        and lows[i] < lows[i + 1]
        and lows[i] < lows[i + 2]
    ):
      swing_lows.append(lows[i])
  tr_list = []
  for i in range(1, min(15, n)):
    tr = max(
        highs[-i] - lows[-i],
        abs(highs[-i] - closes[-i - 1]),
        abs(lows[-i] - closes[-i - 1]),
    )
    tr_list.append(tr)
  atr = (
      sum(tr_list) / len(tr_list)
      if tr_list
      else (highs[-1] * 0.035 if highs else 1.0)
  )
  return swing_highs, swing_lows, atr


def calculate_fibonacci_levels(highs, lows, decimals=2):
  if not highs or not lows:
    return {
        "macro_high": "N/A",
        "macro_low": "N/A",
        "fib_236": "N/A",
        "fib_382": "N/A",
        "fib_500": "N/A",
        "fib_618": "N/A",
        "fib_786": "N/A",
    }
  macro_high, macro_low = max(highs), min(lows)
  diff = macro_high - macro_low
  return {
      "macro_high": round(macro_high, decimals),
      "macro_low": round(macro_low, decimals),
      "fib_236": round(macro_high - (diff * 0.236), decimals),
      "fib_382": round(macro_high - (diff * 0.382), decimals),
      "fib_500": round(macro_high - (diff * 0.500), decimals),
      "fib_618": round(macro_high - (diff * 0.618), decimals),
      "fib_786": round(macro_high - (diff * 0.786), decimals),
  }


def calculate_volume_profile_weights(
    highs, lows, closes, volumes, fib_levels, decimals=2
):
  if (
      not highs
      or not lows
      or not volumes
      or fib_levels.get("macro_high") == "N/A"
  ):
    return fib_levels, {}

  macro_high = fib_levels["macro_high"]
  macro_low = fib_levels["macro_low"]
  diff = macro_high - macro_low
  if diff <= 0:
    return fib_levels, {}

  bins_count = 30
  bin_width = diff / bins_count
  volume_profile = [0.0] * bins_count

  for h, l, c, v in zip(highs, lows, closes, volumes):
    typical_price = (h + l + c) / 3.0
    bin_idx = int((typical_price - macro_low) / bin_width)
    bin_idx = max(0, min(bins_count - 1, bin_idx))
    volume_profile[bin_idx] += float(v)

  indexed_profile = sorted(
      enumerate(volume_profile), key=lambda x: x[1], reverse=True
  )
  hvn_prices = [
      macro_low + (idx + 0.5) * bin_width for idx, _ in indexed_profile[:3]
  ]

  fib_keys = ["fib_236", "fib_382", "fib_500", "fib_618", "fib_786"]
  weights = {}
  for f_key in fib_keys:
    f_val = fib_levels.get(f_key)
    if f_val == "N/A":
      continue
    score = 1.0
    for hvn in hvn_prices:
      if abs(f_val - hvn) <= (bin_width * 1.5):
        score += 2.5
    weights[f_key] = round(score, 1)

  return fib_levels, weights


def calculate_grid_targets(
    current_price, fib_levels, highs, lows, closes, decimals=2
):
  if current_price == "N/A" or fib_levels.get("fib_382") == "N/A":
    return {"buy_target": "N/A", "sell_target": "N/A"}

  fib_382 = fib_levels["fib_382"]
  fib_500 = fib_levels["fib_500"]
  fib_618 = fib_levels["fib_618"]
  macro_high = fib_levels["macro_high"]
  macro_low = fib_levels["macro_low"]
  macro_range = macro_high - macro_low

  tr_list = []
  n = len(closes)
  for i in range(1, min(15, n)):
    tr = max(
        highs[-i] - lows[-i],
        abs(highs[-i] - closes[-i - 1]),
        abs(lows[-i] - closes[-i - 1]),
    )
    tr_list.append(tr)
  atr = sum(tr_list) / len(tr_list) if tr_list else float(current_price) * 0.04

  if current_price > fib_382:
    buy_target = fib_382
  elif current_price > fib_500:
    buy_target = fib_500
  elif current_price > fib_618:
    buy_target = fib_618
  else:
    buy_target = current_price - (atr * 1.5)

  if current_price < fib_618:
    sell_target = fib_500
  elif current_price < fib_500:
    sell_target = fib_382
  elif current_price < macro_high:
    sell_target = macro_high
  else:
    sell_target = macro_high + (macro_range * 0.272)

  if sell_target <= current_price:
    sell_target = current_price + (atr * 2.0)
  if buy_target >= current_price:
    buy_target = current_price - (atr * 1.2)

  return {
      "buy_target": round(buy_target, decimals),
      "sell_target": round(sell_target, decimals),
  }


def get_dow_status(
    swing_highs, swing_lows, current_price, recent_closes, fib_levels
):
  if current_price == "N/A" or fib_levels.get("fib_382") == "N/A":
    return "N/A", "API 數據獲取失敗，標記為 N/A"

  if current_price > fib_levels["fib_382"]:
    return "Primary Bull", "SOS 強勢修復"
  elif current_price < fib_levels["fib_618"]:
    return "Secondary Correction", "空頭壓制"

  if len(swing_highs) >= 2 and len(swing_lows) >= 2:
    last_high, prev_high = swing_highs[-1], swing_highs[-2]
    last_low, prev_low = swing_lows[-1], swing_lows[-2]

    if current_price > last_high:
      return "Primary Bull", "強勢突破"
    if last_high >= prev_high and last_low >= prev_low:
      return "Primary Bull", "多頭推進"
    elif last_high <= prev_high and last_low <= prev_low:
      return "Secondary Correction", "空頭受阻"
    else:
      return "Consolidation", "結構收斂"
  else:
    return (
        ("Primary Bull", "趨勢延續")
        if current_price >= recent_closes[0]
        else ("Consolidation", "趨勢延續")
    )


def analyze_wyckoff_vsa(highs, lows, closes, volumes, fib_levels, dow_status):
  if not closes or len(closes) < 30 or dow_status == "N/A":
    return (
        "N/A",
        "⚠️【數據缺失】API 斷線或數據不足，無法執行威科夫 VSA 診斷 (N/A)。",
    )

  vol_sma = sum(volumes[-20:]) / 20.0 if len(volumes) >= 20 else 1.0
  recent_3d_vol = sum(volumes[-3:]) / 3.0 if len(volumes) >= 3 else 1.0
  curr_close = closes[-1]
  prev_close = closes[-4] if len(closes) >= 4 else closes[0]
  curr_high, curr_low = max(highs[-3:]), min(lows[-3:])
  curr_spread = curr_high - curr_low if curr_high - curr_low > 0 else 0.001
  close_pos = (curr_close - curr_low) / curr_spread
  is_high_vol = recent_3d_vol > vol_sma * 1.2
  is_low_vol = recent_3d_vol < vol_sma * 0.8
  fib_382, fib_618 = fib_levels["fib_382"], fib_levels["fib_618"]

  recent_max_20 = max(highs[-20:])
  recent_min_20 = min(lows[-20:])
  price_span = recent_max_20 - recent_min_20
  is_bouncing_from_low = (
      (curr_close - recent_min_20) > price_span * 0.5
      if price_span > 0
      else False
  )

  if curr_low <= fib_618 * 1.015:
    if is_bouncing_from_low and dow_status == "Secondary Correction":
      return (
          "PHASE B",
          "⚖️【高位回調】雖觸及 618 幾何支撐，但屬於自低位反彈後的回測，盈虧比不佳，建議暫時觀望。",
      )

    if is_low_vol:
      return (
          "PHASE C",
          "🔥【強力買進】無供應測試 (No Supply)：賣壓枯竭，右側絕佳買點！",
      )
    elif is_high_vol and close_pos >= 0.5:
      if dow_status == "Primary Bull":
        return (
            "PHASE C",
            "🔥【強力買進】完美共振！主升趨勢中的彈簧洗盤 (Spring)，絕佳波段買點。",
        )
      elif dow_status == "Secondary Correction":
        return (
            "PHASE C",
            "🔥【強力買進】極度低估！宏觀極限回調出現恐慌拋售與彈簧洗盤，左側摸底。",
        )
      else:
        return (
            "PHASE C",
            "🔥【強力買進】區間極限測試！彈簧洗盤 (Spring) 爆量收腳，主力吃貨。",
        )
    elif is_high_vol and close_pos < 0.5:
      if dow_status == "Secondary Correction":
        return "PHASE E", "🛑【逃頂賣出】趨勢破壞！空頭結構全面崩盤，嚴格停損。"
      return "PHASE A", "【恐慌拋售】近三日放量跌破 618，賣壓沉重，觀望勿接飛刀。"
    else:
      return "PHASE C", "【邊界測試】位於 618 深水區防守測試中，等待量能表態。"

  elif curr_high >= fib_382 * 0.985:
    if is_high_vol and close_pos <= 0.3 and curr_close < prev_close:
      if dow_status == "Primary Bull":
        return (
            "PHASE B",
            "🛑【逃頂賣出】高位假突破 (UTAD)！爆量卻留長上影線，主力倒貨！",
        )
      elif dow_status == "Secondary Correction":
        return (
            "PHASE B",
            "⚠️【死貓反彈】空頭結構微觀拉升 (LPSY)，遭遇解套賣壓，注意誘多風險！",
        )
      else:
        return (
            "PHASE B",
            "🛑【逃頂賣出】上衝回落 (Upthrust)：高檔爆量卻無法收高，危險訊號！",
        )

    elif (
        curr_close >= fib_382 * 0.98
        and curr_close < closes[-2]
        and is_low_vol
    ):
      # 對齊 PHASE D 鎖定的 Fib 0.236 淺回踩買點
      target_support = (
          fib_levels.get("fib_236")
          if fib_levels.get("fib_236") != "N/A"
          else fib_382
      )
      buy_zone_upper = target_support * 1.0135
      decimals = 2 if target_support >= 1.0 else 4

      # 格式化數值字串，完全去除多餘反斜線及 LaTeX 語法
      p_low = f"{target_support:,.{decimals}f}"
      p_high = f"{buy_zone_upper:,.{decimals}f}"

      return (
          "PHASE D",
          f"✅【回踩確認】(BUEC) 突破後縮量回測支撐，確認為真實 SOS，右側買點浮現。於 {p_low} 至 {p_high} 之間設定分批買單。",
      )

    elif curr_close > prev_close and is_high_vol and close_pos >= 0.5:
      if dow_status == "Primary Bull":
        return (
            "PHASE D",
            "🚀【強勢表態】(SOS) 爆量突破強壓！(準備觀察後續是否縮量回踩)",
        )
      else:
        return "PHASE D", "🚀【強勢表態】需求強勁湧現，挑戰上方強壓區。"

    elif curr_close > prev_close and is_low_vol:
      return (
          "PHASE B",
          "⚠️【高位誘多】需求不足 (No Demand)：無量過高，提防假突破！",
      )

    else:
      if dow_status == "Primary Bull":
        return (
            "PHASE D",
            "【頂部突破】挑戰上方強壓區，關注多頭量能是否持續堆積。",
        )
      else:
        return "PHASE D", "【區間突圍】多空交戰中，嚴格觀望，等待方向表態。"

  else:
    if curr_close < prev_close and is_low_vol:
      return (
          "PHASE C",
          "【二次測試】(Secondary Test) 區間內回調且連續縮量，測試下方籌碼。",
      )
    elif curr_close > prev_close and is_high_vol:
      return (
          "PHASE D",
          "【標記躍升】(Minor SOS) 區間內連續放量上攻，買盤積極換手。",
      )
    else:
      if dow_status == "Consolidation":
        return (
            "PHASE B",
            "⚖️【籌碼沉澱】主力建立部位中，無明確方向，建議嚴格執行高拋低吸。",
        )
      return "PHASE B", "【區間震盪】於黃金區間內縮量換手，籌碼沉澱中。"


def analyze_mstr_mnav(mnav):
  if mnav >= 2.0:
    return (
        "OVERVALUED",
        "🛑【逃頂賣出】溢價過高！mNAV 超過 2.0x 極端溢價，脫離 BTC"
        " 基本面，強烈建議獲利了結！",
    )
  elif mnav >= 1.6:
    return (
        "PREMIUM",
        "⚠️【高位溢價】mNAV 達 1.6x 以上，處於歷史相對高位，建議停止追高。",
    )
  elif mnav <= 0.95:
    return (
        "DISCOUNT",
        "🚀【極度低估】mNAV 罕見跌破 1.0x 產生折價！絕對的黃金抄底坑！",
    )
  elif mnav <= 1.15:
    return (
        "UNDERVALUED",
        "🔥【強力買進】折價買進！mNAV 接近基準線，溢價泡沫已洗淨，具備極高安全邊際！",
    )
  else:
    return (
        "FAIR VALUE",
        "⚖️【合理區間】mNAV 位於 1.15x - 1.6x 常態區間，隨 BTC 現貨連動，無極端情緒干擾。",
    )


def analyze_crypto_symbol(
    symbol_binance, coingecko_id, vs_currency="usd", okx_inst_id=None
):
  current_price = 0.0
  highs, lows, closes, volumes = [], [], [], []
  limit_days = 100

  if okx_inst_id:
    try:
      okx_kline_url = f"https://www.okx.com/api/v5/market/candles?instId={okx_inst_id}&bar=1D&limit={limit_days}"
      res = session.get(okx_kline_url, headers=DEFAULT_HEADERS, timeout=5).json()
      if res.get("code") == "0" and len(res.get("data", [])) >= 20:
        raw_candles = res["data"][::-1]
        closes = [float(k[4]) for k in raw_candles if k[4] is not None]
        highs = [float(k[2]) for k in raw_candles if k[2] is not None]
        lows = [float(k[3]) for k in raw_candles if k[3] is not None]
        volumes = [float(k[5]) for k in raw_candles if k[5] is not None]
        current_price = closes[-1]
    except Exception:
      pass

  if current_price == 0.0 or len(closes) < 20:
    try:
      bn_url = f"https://api.binance.com/api/v3/klines?symbol={symbol_binance}&interval=1d&limit={limit_days}"
      res = session.get(bn_url, headers=DEFAULT_HEADERS, timeout=5).json()
      if isinstance(res, list) and len(res) >= 20:
        closes = [float(k[4]) for k in res if k[4] is not None]
        highs = [float(k[2]) for k in res if k[2] is not None]
        lows = [float(k[3]) for k in res if k[3] is not None]
        volumes = [float(k[5]) for k in res if k[5] is not None]
        current_price = closes[-1]
    except Exception:
      pass

  if current_price == 0.0 or len(closes) < 20:
    try:
      cg_url = f"https://api.coingecko.com/api/v3/coins/{coingecko_id}/market_chart?vs_currency={vs_currency}&days={limit_days}&interval=daily"
      res = session.get(cg_url, headers=DEFAULT_HEADERS, timeout=6).json()
      p_data, v_data = res.get("prices", []), res.get("total_volumes", [])
      if len(p_data) >= 20:
        min_len = min(len(p_data), len(v_data))
        closes = [float(p[1]) for p in p_data[-min_len:]]
        volumes = [float(v[1]) for v in v_data[-min_len:]]
        highs = [c * 1.02 for c in closes]
        lows = [c * 0.98 for c in closes]
        current_price = closes[-1]
    except Exception:
      pass

  if current_price == 0.0 or not closes:
    return {
        "price": "N/A",
        "dow_status": "N/A",
        "dow_signal": "API 連線失敗，數據缺失 (N/A)",
        "support": "N/A",
        "resistance": "N/A",
        "buy_target": "N/A",
        "sell_target": "N/A",
        "wyckoff_phase": "N/A",
        "wyckoff_hint": "🛑【數據異常】無法取得即時行情與歷史 K 線。",
        "fib_236": "N/A",
        "fib_382": "N/A",
        "fib_500": "N/A",
        "fib_618": "N/A",
        "fib_weights": {},
    }

  decimals = 5 if current_price < 0.1 else (3 if current_price < 50 else 2)
  fib_levels = calculate_fibonacci_levels(highs, lows, decimals)
  fib_levels, fib_weights = calculate_volume_profile_weights(
      highs, lows, closes, volumes, fib_levels, decimals
  )

  swing_plan = calculate_grid_targets(
      current_price, fib_levels, highs, lows, closes, decimals
  )

  recent_highs, recent_lows, recent_closes = (
      highs[-45:],
      lows[-45:],
      closes[-45:],
  )
  swing_highs, swing_lows, atr = find_fractal_pivots(
      recent_highs, recent_lows, recent_closes
  )

  dow_status, dow_signal = get_dow_status(
      swing_highs, swing_lows, current_price, recent_closes, fib_levels
  )
  wyckoff_phase, wyckoff_hint = analyze_wyckoff_vsa(
      highs, lows, closes, volumes, fib_levels, dow_status
  )

  overhead = [h for h in swing_highs if h > current_price]
  resistance = min(overhead) if overhead else (current_price + atr * 1.618)
  underlying = [l for l in swing_lows if l < current_price]
  support = max(underlying) if underlying else (current_price - atr * 1.618)

  final_buy_target = swing_plan["buy_target"]
  final_sell_target = swing_plan["sell_target"]

  if (
      wyckoff_phase == "PHASE C"
      and fib_levels["fib_618"] != "N/A"
      and fib_levels["fib_618"] < current_price
  ):
    final_buy_target = fib_levels["fib_618"]
  elif (
      wyckoff_phase == "PHASE D"
      and fib_levels["fib_236"] != "N/A"
      and fib_levels["fib_236"] < current_price
  ):
    final_buy_target = fib_levels["fib_236"]

  return {
      "price": round(current_price, decimals),
      "dow_status": dow_status,
      "dow_signal": dow_signal,
      "support": round(support, decimals) if support != "N/A" else "N/A",
      "resistance": (
          round(resistance, decimals) if resistance != "N/A" else "N/A"
      ),
      "buy_target": (
          round(final_buy_target, decimals) if final_buy_target != "N/A" else "N/A"
      ),
      "sell_target": (
          round(final_sell_target, decimals)
          if final_sell_target != "N/A"
          else "N/A"
      ),
      "wyckoff_phase": wyckoff_phase,
      "wyckoff_hint": wyckoff_hint,
      "fib_236": fib_levels["fib_236"],
      "fib_382": fib_levels["fib_382"],
      "fib_500": fib_levels["fib_500"],
      "fib_618": fib_levels["fib_618"],
      "fib_weights": fib_weights,
  }


def analyze_tokenized_stock(
    stock_ticker,
    okx_prefix,
    is_mstr=False,
    btc_price=0,
    official_base_stock=153.92,
    official_base_mnav=1.21,
):
  current_price = 0.0
  highs, lows, closes, volumes = [], [], [], []
  limit_days = 100

  okx_inst_ids = [f"{okx_prefix}-USDT", f"{okx_prefix}-USDT-SWAP"]
  for instId in okx_inst_ids:
    if current_price != 0.0:
      break
    try:
      okx_url = f"https://www.okx.com/api/v5/market/ticker?instId={instId}"
      res = session.get(okx_url, headers=DEFAULT_HEADERS, timeout=4).json()
      if res.get("code") == "0" and len(res.get("data", [])) > 0:
        current_price = float(res["data"][0]["last"])
    except Exception:
      continue

  try:
    url = f"https://query1.finance.yahoo.com/v8/finance/chart/{stock_ticker}?interval=1d&range={limit_days}d"
    res = session.get(url, headers=DEFAULT_HEADERS, timeout=6).json()
    quotes = res["chart"]["result"][0]["indicators"]["quote"][0]
    valid = [
        (c, h, l, v)
        for c, h, l, v in zip(
            quotes["close"], quotes["high"], quotes["low"], quotes["volume"]
        )
        if None not in (c, h, l, v)
    ]
    if valid:
      closes = [float(x[0]) for x in valid]
      highs = [float(x[1]) for x in valid]
      lows = [float(x[2]) for x in valid]
      volumes = [float(x[3]) for x in valid]
      if current_price == 0.0:
        current_price = closes[-1]
  except Exception:
    pass

  if current_price == 0.0 or not closes:
    return {
        "price": "N/A",
        "dow_status": "N/A",
        "dow_signal": "API 連線失敗，數據缺失 (N/A)",
        "buy_target": "N/A",
        "sell_target": "N/A",
        "wyckoff_phase": "N/A",
        "wyckoff_hint": "🛑【數據異常】無法取得美股/代幣化資產行情。",
        "fib_236": "N/A",
        "fib_382": "N/A",
        "fib_500": "N/A",
        "fib_618": "N/A",
        "fib_weights": {},
    }

  fib_levels = calculate_fibonacci_levels(highs, lows, 2)
  fib_levels, fib_weights = calculate_volume_profile_weights(
      highs, lows, closes, volumes, fib_levels, 2
  )
  swing_plan = calculate_grid_targets(
      current_price, fib_levels, highs, lows, closes, 2
  )

  recent_highs, recent_lows, recent_closes = (
      highs[-45:],
      lows[-45:],
      closes[-45:],
  )
  swing_highs, swing_lows, atr = find_fractal_pivots(
      recent_highs, recent_lows, recent_closes
  )
  dow_status, dow_signal = get_dow_status(
      swing_highs, swing_lows, current_price, recent_closes, fib_levels
  )
  final_buy_target, final_sell_target = (
      swing_plan["buy_target"],
      swing_plan["sell_target"],
  )

  if is_mstr:
    official_base_btc = 81240.0
    stock_ratio = current_price / official_base_stock
    btc_ratio = btc_price / official_base_btc if btc_price > 0 else 1.0
    mnav_multiple = round(official_base_mnav * (stock_ratio / btc_ratio), 2)
    stock_phase, stock_hint = analyze_mstr_mnav(mnav_multiple)

    return {
        "price": round(current_price, 2),
        "mnav_multiple": f"{mnav_multiple}x",
        "dow_status": dow_status,
        "dow_signal": dow_signal,
        "buy_target": round(final_buy_target, 2),
        "sell_target": round(final_sell_target, 2),
        "wyckoff_phase": stock_phase,
        "wyckoff_hint": stock_hint,
        "fib_236": fib_levels["fib_236"],
        "fib_382": fib_levels["fib_382"],
        "fib_500": fib_levels["fib_500"],
        "fib_618": fib_levels["fib_618"],
        "fib_weights": fib_weights,
    }
  else:
    wyckoff_phase, wyckoff_hint = analyze_wyckoff_vsa(
        highs, lows, closes, volumes, fib_levels, dow_status
    )
    return {
        "price": round(current_price, 2),
        "dow_status": dow_status,
        "dow_signal": dow_signal,
        "buy_target": round(final_buy_target, 2),
        "sell_target": round(final_sell_target, 2),
        "wyckoff_phase": wyckoff_phase,
        "wyckoff_hint": wyckoff_hint,
        "fib_236": fib_levels["fib_236"],
        "fib_382": fib_levels["fib_382"],
        "fib_500": fib_levels["fib_500"],
        "fib_618": fib_levels["fib_618"],
        "fib_weights": fib_weights,
    }


def main():
  btc_data = analyze_crypto_symbol("BTCUSDT", "bitcoin", okx_inst_id="BTC-USDT")
  eth_data = analyze_crypto_symbol(
      "ETHUSDT", "ethereum", okx_inst_id="ETH-USDT"
  )
  ethbtc_data = analyze_crypto_symbol("ETHBTC", "ethereum", "btc")
  sol_data = analyze_crypto_symbol("SOLUSDT", "solana", okx_inst_id="SOL-USDT")
  uni_data = analyze_crypto_symbol("UNIUSDT", "uniswap", okx_inst_id="UNI-USDT")
  ray_data = analyze_crypto_symbol("RAYUSDT", "raydium", okx_inst_id="RAY-USDT")
  near_data = analyze_crypto_symbol("NEARUSDT", "near", okx_inst_id="NEAR-USDT")
  zec_data = analyze_crypto_symbol("ZECUSDT", "zcash", okx_inst_id="ZEC-USDT")

  # 取得比特幣挖礦生產總成本
  btc_mining_cost = get_btc_production_cost()

  # 取得比特幣 MVRV Z-Score 與宏觀狀態分析
  mvrv_zscore = get_btc_mvrv_zscore()

  if mvrv_zscore is None or mvrv_zscore == 0.0:
    final_mvrv_val = "N/A"
  else:
    final_mvrv_val = mvrv_zscore

  mvrv_phase, mvrv_hint = analyze_mvrv_status(final_mvrv_val)

  btc_data["mvrv_zscore"] = final_mvrv_val
  btc_data["mvrv_phase"] = mvrv_phase
  btc_data["mvrv_hint"] = mvrv_hint

  # 新增：動態抓取比特幣現貨 ETF 1D 與 5D 淨流入
  btc_etf_flows = get_btc_etf_flows()

  btc_ref_price = (
      float(btc_data["price"]) if btc_data["price"] != "N/A" else 80000.0
  )
  mstr_data = analyze_tokenized_stock(
      "MSTR",
      "XMSTR",
      is_mstr=True,
      btc_price=btc_ref_price,
      official_base_stock=153.92,
      official_base_mnav=1.21,
  )
  xcoin_data = analyze_tokenized_stock("COIN", "XCOIN")
  xadbe_data = analyze_tokenized_stock("ADBE", "XADBE")
  xcrcl_data = analyze_tokenized_stock("CRCL", "XCRCL")

  output = {
      "updated_at": datetime.datetime.now(datetime.timezone.utc).strftime(
          "%Y-%m-%d %H:%M UTC"
      ),
      "btc_mining_cost": btc_mining_cost,
      "btc_mvrv": {
          "zscore": final_mvrv_val,
          "phase": mvrv_phase,
          "hint": mvrv_hint,
      },
      "btc_etf": btc_etf_flows,
      "btc": btc_data,
      "eth": eth_data,
      "ethbtc": ethbtc_data,
      "sol": sol_data,
      "uni": uni_data,
      "ray": ray_data,
      "near": near_data,
      "zec": zec_data,
      "mstr": mstr_data,
      "xcoin": xcoin_data,
      "xadbe": xadbe_data,
      "xcrcl": xcrcl_data,
  }

  with open("data.json", "w", encoding="utf-8") as f:
    json.dump(output, f, ensure_ascii=False, indent=2)
  print(
      f"data.json 成功更新！挖礦成本: {btc_mining_cost}，MVRV Z-Score:"
      f" {final_mvrv_val} ({mvrv_phase})，ETF: {btc_etf_flows['flow_1d']} (1D) |"
      f" {btc_etf_flows['flow_5d']} (5D)"
  )


if __name__ == "__main__":
  main()
